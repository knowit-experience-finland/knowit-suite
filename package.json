{
  "name": "knowit-suite",
  "description": "Knowit Suite – fast Playwright tests for website quality",
  "author": "Knowit Experience Oy",
  "license": "MIT",
  "version": "2.1.0",
  "type": "module",
  "bin": {
    "knowit-suite": "bin/knowit-suite.js"
  },
  "files": [
    "knowit-suite",
    "bin"
  ],
  "engines": {
    "node": ">=18.16"
  },
  "scripts": {
    "about:lint": "echo 'Run ESLint'",
    "lint": "eslint . *.js",
    "about:format": "echo 'Run Prettier'",
    "format": "prettier --write .",
    "test": "npx playwright test",
    "test:clean": "npx playwright test --update-snapshots",
    "about:setup": "echo \"Once after cloning this repo: browsers and Git hooks\"",
    "setup": "npx playwright install && husky",
    "test:unit": "node --test unit/*.test.js"
  },
  "peerDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "axe-html-reporter": "^2.2.11",
    "dotenv": "^16.4.7",
    "lighthouse": "^12.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.6",
    "axe-html-reporter": "^2.2.11",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lighthouse": "^12.8.2",
    "prettier": "^3.4.2"
  }
}
